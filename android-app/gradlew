
#!/usr/bin/env sh
set -eu

GRADLE_VERSION="8.7"
GRADLE_HOME="${HOME}/.gradle/guardian-bootstrap/gradle-${GRADLE_VERSION}"
GRADLE_ZIP="${HOME}/.gradle/guardian-bootstrap/gradle-${GRADLE_VERSION}-bin.zip"

if [ ! -x "${GRADLE_HOME}/bin/gradle" ]; then
    mkdir -p "$(dirname "${GRADLE_ZIP}")"

    echo "Downloading Gradle ${GRADLE_VERSION}..."

    curl -fL --retry 3 \
        "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
        -o "${GRADLE_ZIP}"

    unzip -q -o "${GRADLE_ZIP}" \
        -d "$(dirname "${GRADLE_HOME}")"
fi

exec "${GRADLE_HOME}/bin/gradle" "$@"
